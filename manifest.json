{
  "manifest_version": 3,
  "name": "Yandex Ads Scraper",
  "version": "2.0.0",
  "description": "Collect advertising data from Yandex search results",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "sidePanel",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://yandex.ru/*",
    "https://ya.ru/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://yandex.ru/search*",
        "https://ya.ru/search*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
